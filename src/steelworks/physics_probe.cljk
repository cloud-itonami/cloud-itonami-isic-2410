(ns steelworks.physics-probe
  "The physical-AI bot's measurement: run this actor's REAL `physics-2d`
  steel-coupon tensile-test simulation (`steelworks.robotics`, ASTM A370 /
  ISO 6892, dynamic rate per the ISO 26203 family) over a fixed sweep and
  print ONE EDN map of the physical quantities it computed.

    kbb -M:dev:physics

  This is what the resident bot (hermes/profiles/physai-isic-2410/SOUL.md)
  reads every tick. Every number below is derived from a time-stepped
  trajectory by `steelworks.robotics/run-tensile-test`, never typed in.
  Output schema `itonami.physical-ai.probe.v1`:

    {:physics-probe/schema \"itonami.physical-ai.probe.v1\"
     :repo :procedure :solver
     :runs     [{:input {...} :quantities {...} :out-of-tolerance? bool} ...]
     :derived  {...}   ; quantities computed ACROSS runs
     :count n :expected n}

  `:count` is an evidence floor: 0 means \"could not measure\", never
  \"nothing out of tolerance\". Exit 0 when every run produced numbers,
  2 when any run did not."
  (:require [steelworks.robotics :as robotics]))

(def schema "itonami.physical-ai.probe.v1")

(def sweep-coupon-masses-kg
  "Effective participating masses swept at the fixed test speed. 1.0 kg
  (too light) and 5.0 kg (comfortably heavy) are the fixtures the
  robotics/governor tests pin; 2.0 / 4.0 are the export-test fixtures;
  8.0 extends the bracket so a slope change shows."
  [1.0 2.0 4.0 5.0 8.0])

(def sweep-test-speeds-mps
  "Jaw pull rates swept at the 5.0 kg fixture mass. 2.0 m/s is
  `robotics/test-speed-mps`; the others bracket it so the speed scaling
  of the reading is measured, not assumed."
  [1.0 2.0 4.0])

(def speed-sweep-mass-kg 5.0)

(def ^:private telemetry-keys
  [:sim-tensile-load-n :sim-peak-decel-mps2 :ticks :dt
   :test-speed-mps :travel-to-peak-load-m])

(defn- telemetry [mass-kg speed-mps]
  (select-keys (robotics/run-tensile-test mass-kg {:test-speed-mps speed-mps})
               telemetry-keys))

(defn- run-one [input t]
  {:input input
   :quantities t
   :out-of-tolerance? (robotics/tensile-test-out-of-tolerance? t)})

(defn- load-at [mass-kg]
  (:sim-tensile-load-n (robotics/tensile-test-telemetry-for {:coupon-mass-kg mass-kg})))

(defn min-passing-coupon-mass-kg
  "Smallest effective coupon mass whose simulated peak tensile load
  reaches `robotics/min-tensile-load-n`, by bisection over the REAL
  simulation (load is monotone in mass at fixed speed/travel -- pinned by
  `robotics-test`). nil when the bracket does not straddle the floor."
  ([] (min-passing-coupon-mass-kg 0.001 20.0 40))
  ([lo hi iters]
   (let [floor robotics/min-tensile-load-n]
     (when (and (< (load-at lo) floor) (>= (load-at hi) floor))
       (loop [lo lo hi hi i 0]
         (if (>= i iters)
           hi
           (let [mid (/ (+ lo hi) 2.0)]
             (if (>= (load-at mid) floor)
               (recur lo mid (inc i))
               (recur mid hi (inc i))))))))))

(defn- ln [x] #?(:cljs (js/Math.log x) :default (Math/log (double x))))

(defn- log2 [x] (/ (ln x) (ln 2.0)))

(defn probe []
  (let [mass-runs (mapv (fn [m] (run-one {:coupon-mass-kg m}
                                         (robotics/tensile-test-telemetry-for {:coupon-mass-kg m})))
                        sweep-coupon-masses-kg)
        speed-runs (mapv (fn [v] (run-one {:coupon-mass-kg speed-sweep-mass-kg :test-speed-mps v}
                                          (telemetry speed-sweep-mass-kg v)))
                         sweep-test-speeds-mps)
        runs (into mass-runs speed-runs)
        numeric? (fn [r] (number? (get-in r [:quantities :sim-tensile-load-n])))
        decels (map #(get-in % [:quantities :sim-peak-decel-mps2]) speed-runs)
        speeds sweep-test-speeds-mps]
    {:physics-probe/schema schema
     :repo "cloud-itonami/cloud-itonami-isic-2410"
     :procedure "ASTM A370 / ISO 6892 steel-coupon tensile test at a dynamic rate (ISO 26203 family), robot tensile-test cell"
     :solver "physics-2d/world-step"
     :runs runs
     :derived {:min-tensile-load-n robotics/min-tensile-load-n
               :min-passing-coupon-mass-kg (min-passing-coupon-mass-kg)
               ;; d log(decel) / d log(speed) between the lowest and highest
               ;; swept speed -- 2.0 means decel = v^2/travel exactly.
               :decel-speed-exponent
               (when (every? pos? decels)
                 (/ (log2 (/ (last decels) (first decels)))
                    (log2 (/ (last speeds) (first speeds)))))}
     :count (count (filter numeric? runs))
     :expected (+ (count sweep-coupon-masses-kg) (count sweep-test-speeds-mps))}))

(defn -main [& _]
  (let [p (probe)]
    (prn p)
    (when-not (= (:count p) (:expected p))
      #?(:cljs (set! (.-exitCode js/process) 2)
         :default (System/exit 2)))))
